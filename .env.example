# Jan Arogya Nexus — environment configuration
#
# The app runs fully in DEMO MODE with no configuration (seeded data, in-browser
# persistence). To connect a real Supabase project, set the two public values
# below. The anon key is safe for the browser; a service-role key must NEVER be
# placed in any VITE_* variable or committed anywhere.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force demo mode even when the above are set.
VITE_DEMO_MODE=

# Jan Arogya Portal — backend environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored: NEVER commit real secrets.
# Every variable here is validated at boot by src/config/env.ts (Zod); the
# process refuses to start on invalid configuration.

# --- Runtime -----------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# --- Logging -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- CORS --------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep false until the API moves to cookie sessions (Phase 3).
CORS_CREDENTIALS=false

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Request ID --------------------------------------------------------
# Inbound header honored as the request ID; echoed on every response.
REQUEST_ID_HEADER=x-request-id

# --- Database (PostgreSQL + Prisma) --------------------------------------
# Matches docker-compose.yml. Required by Prisma CLI and the Prisma client.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jap

# --- Sessions (Phase 3 — authentication) --------------------------------
# HttpOnly SameSite=Lax cookie (`jap_session`). SESSION_SECRET is reserved for
# future signed-cookie use; the current in-memory store uses an opaque UUID.
SESSION_COOKIE_NAME=jap_session
SESSION_TTL_HOURS=8
# Set to true in production (requires HTTPS).
SESSION_SECURE=false
SESSION_SECRET=dev-only-change-me-32-chars-minimum-for-session-secret

# --- Reserved for later phases (not read yet) ---------------------------
# ABDM_MODE=mock
# ABDM_BASE_URL=
# BLOCKCHAIN_MODE=off

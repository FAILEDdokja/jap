# Jan Arogya Portal — backend environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored: NEVER commit real secrets.
# Every variable here is validated at boot by src/config/env.ts (Zod); the
# process refuses to start on invalid configuration.

# --- Runtime -----------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# --- Logging -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- CORS --------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep false until the API moves to cookie sessions (Phase 3).
CORS_CREDENTIALS=false

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Request ID --------------------------------------------------------
# Inbound header honored as the request ID; echoed on every response.
REQUEST_ID_HEADER=x-request-id

# --- Reserved for later phases (not read yet) ---------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/jap
# SESSION_SECRET=
# ABDM_MODE=mock
# ABDM_BASE_URL=
# BLOCKCHAIN_MODE=off

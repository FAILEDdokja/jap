# Jan Arogya Portal — backend environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored: NEVER commit real secrets.
# Every variable here is validated at boot by src/config/env.ts (Zod); the
# process refuses to start on invalid configuration.
#
# PRODUCTION NOTE (Phase 4): when NODE_ENV=production a second gate runs and
# REFUSES TO START if any value below is still a development default — the dev
# session secret, a loopback DATABASE_URL, a wildcard/loopback/http CORS origin,
# an in-memory audit store, a fail-open audit policy, public /docs, or metrics
# without a token. Production never silently falls back. See
# docs/operations/deployment.md §5.

# --- Runtime -----------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# --- Logging -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- CORS --------------------------------------------------------------
# Comma-separated EXACT origins allowed to call the API from a browser.
# Production: https only, no wildcard, no loopback, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true wherever the cookie session is used from a browser.
CORS_CREDENTIALS=false

# --- Rate limiting -----------------------------------------------------
# Global per-IP baseline. Rationale for every value below:
# docs/decisions/0004-rate-limiting.md.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Sensitive endpoints (authentication, identity verification).
# Per-IP: charged on every attempt.
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=300
# Per-target (identifier / ABHA): charged on FAILED attempts only, so a user
# who signs in correctly is never locked out of their own account.
RATE_LIMIT_AUTH_TARGET_MAX=5
RATE_LIMIT_AUTH_TARGET_WINDOW_SECONDS=900
# Per-authenticated-account write budget.
RATE_LIMIT_ACCOUNT_MAX=120
RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=60

# --- Request ID --------------------------------------------------------
# Inbound header honored as the request ID; echoed on every response.
REQUEST_ID_HEADER=x-request-id

# --- Database (PostgreSQL + Prisma) --------------------------------------
# Matches docker-compose.yml. Required by the Prisma CLI, the Prisma client,
# and the persistent audit store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jap

# --- Sessions ----------------------------------------------------------
# HttpOnly cookie (`jap_session`) whose value is an opaque 256-bit random id.
# The authority is the server-side record, so sign-out revokes immediately.
# See docs/decisions/0001-session-security.md.
SESSION_COOKIE_NAME=jap_session
# Absolute lifetime — never extended by use.
SESSION_TTL_HOURS=8
# Idle timeout in minutes; 0 disables. 30 suits shared clinical workstations.
SESSION_IDLE_MINUTES=30
# MUST be true in production (requires HTTPS).
SESSION_SECURE=false
# Lax | Strict | None. None requires SESSION_SECURE=true.
SESSION_SAMESITE=Lax
# Used to HMAC rate-limit targets and reserved for future signed artifacts.
# Production requires >= 32 chars of real entropy; this value is REJECTED there.
SESSION_SECRET=dev-only-change-me-32-chars-minimum-for-session-secret

# --- Audit (docs/decisions/0002-audit-failure-policy.md) -----------------
# postgres | memory. Production requires postgres.
AUDIT_STORE=memory
# closed | open. Fail-closed refuses the action when it cannot be audited.
# Production requires closed.
AUDIT_FAILURE_MODE=closed
# Bounded write so a wedged database cannot hang the clinical path.
AUDIT_WRITE_TIMEOUT_MS=2000

# --- API docs ----------------------------------------------------------
# Swagger UI at /docs. Defaults to on outside production, off in production
# (it is unauthenticated and needs inline scripts, which weakens the CSP).
# DOCS_ENABLED=true

# --- Observability (docs/decisions/0008-observability.md) ----------------
# Prometheus text format at GET /metrics.
METRICS_ENABLED=true
# Bearer token for /metrics. REQUIRED in production when metrics are enabled.
# METRICS_TOKEN=

# --- Transport security --------------------------------------------------
# Strict-Transport-Security. Defaults to on in production, off elsewhere.
# Set to false if the TLS terminator already sets the header.
# HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=15552000

# --- Reserved for later phases (not read yet) ---------------------------
# ABDM (docs/operations/abdm-certification-plan.md) — NOT IMPLEMENTED.
# ABDM_MODE=mock
# ABDM_BASE_URL=
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_API_VERSION=
# BLOCKCHAIN_MODE=off
